+/**
+ * DeepSeek 官方搜索 API（2026-10 开放）：返回结构化标题/链接/摘要，按次计费（$0.75/千次）。
+ * 与上面的 Responses 版区别：这个拿得到来源 URL，适合聚合；上面的版本只能拿到一段总结。
+ */
+export function deepSeekApiSearch(query) {
+  return withTimeWindow((signal) => deepSeekApiSearchRequest(query, signal));
+}
+
+async function deepSeekApiSearchRequest(query, signal) {
+  const root = getConfig();
+  const cfg = root.webSearch?.deepseekApi ?? {};
+  const legacy = root.webSearch?.deepseek ?? {};
+  // 主模型 Key 存在 providerKeys[api.provider] 里，webSearch.deepseek.apiKey 通常是空的；
+  // 只有当前 baseUrl 确实是 DeepSeek 时才拿它兜底，避免把别家的 Key 发给 DeepSeek。
+  const mainKey = /deepseek\.com/i.test(String(root.api?.baseUrl || '')) ? root.providerKeys?.[root.api?.provider] : '';
+  const apiKey = String(cfg.apiKey || legacy.apiKey || process.env.DEEPSEEK_API_KEY || mainKey || '').trim();
+  if (!apiKey) throw new Error('DeepSeek 搜索需要 API Key（设置里填，或环境变量 DEEPSEEK_API_KEY）');
+  const endpoint = String(cfg.baseUrl || 'https://api.deepseek.com/v1/tools/search').replace(/\/+$/, '');
+  const count = Math.min(50, Math.max(1, Number(cfg.count) || 10));
+  const res = await fetch(endpoint, {
+    method: 'POST',
+    headers: {
+      'content-type': 'application/json',
+      authorization: `Bearer ${apiKey}`
+    },
+    body: JSON.stringify({ query, count }),
+    signal: AbortSignal.any([signal, AbortSignal.timeout(Math.max(5000, Number(cfg.timeoutMs) || 20000))])
+  });
+  if (!res.ok) {
+    const text = await readTextBounded(res, SEARCH_JSON_MAX_BYTES).catch(() => '');
+    throw new Error(`DeepSeek 搜索 HTTP ${res.status}：${text.slice(0, 300)}`);
+  }
+  const data = await readSearchJson(res, 'DeepSeek 搜索返回了无法解析的 JSON');
+  const list = Array.isArray(data?.results) ? data.results : [];
+  const results = list
+    .map((item) => ({
+      title: String(item?.title || '').trim(),
+      url: String(item?.url || '').trim(),
+      snippet: String(item?.summary || item?.snippet || '').trim()
+    }))
+    .filter((item) => item.title || item.snippet);
+  if (!results.length) throw new Error('DeepSeek 搜索没有返回结果');
+  return { query, results };
+}
