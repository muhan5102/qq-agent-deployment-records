+  for (const block of String(text || '').replace(/\r/g, '').split(/\n{2,}/)) {
+    const rows = block.split('\n').map((line) => line.trim()).filter(Boolean);
+    const timeIndex = rows.findIndex((line) => line.includes('-->'));
+    if (timeIndex < 0) continue;
+    const start = rows[timeIndex].split('-->')[0].trim().split(':').map(Number);
+    if (!start.length || start.some((n) => !Number.isFinite(n))) continue;
+    const seconds = start.length === 3
+      ? start[0] * 3600 + start[1] * 60 + start[2]
+      : start[0] * 60 + start[1];
+    const content = rows.slice(timeIndex + 1).join(' ')
+      .replace(/<[^>]+>/g, '')
+      .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
+      .replace(/\s+/g, ' ').trim();
+    if (!content || seen.has(content)) continue;
+    seen.add(content);
+    const line = `[${timestampText(seconds)}] ${content}`;
+    if (chars + line.length + 1 > maxChars) break;
+    lines.push(line);
+    chars += line.length + 1;
+  }
+  return lines.join('\n');
