+// 功能性规则模块（识图/语音）放在 data/rules/*.md：只在对应场景注入，平时不占提示词。
+// 按 mtime 缓存，改文件后下一次运行即生效，不需要重启。
+const ruleModuleCache = new Map();
+const ruleModuleWarned = new Set();
+export function loadRuleModule(name) {
+  const file = path.join(DATA_DIR, 'rules', `${name}.md`);
+  try {
+    const mtimeMs = fs.statSync(file).mtimeMs;
+    const hit = ruleModuleCache.get(file);
+    if (hit && hit.mtimeMs === mtimeMs) return hit.text;
+    const text = fs.readFileSync(file, 'utf8').trim();
+    ruleModuleCache.set(file, { mtimeMs, text });
+    return text;
+  } catch (error) {
+    // 文件被删/权限不对时只提醒一次（journalctl 可见），不让整次运行失败。
+    if (!ruleModuleWarned.has(file)) {
+      ruleModuleWarned.add(file);
+      console.warn(`[rules] 规则模块读取失败：${file}（${error?.code || error?.message}）`);
+    }
+    return '';
+  }
+}
