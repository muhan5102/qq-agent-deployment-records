+  /**
+   * 触发消息里带的图片：下载成 data URL，随请求一起发给模型。
+   *
+   * 2026-10-17：实测她经常"看着 [图片] 占位符"就接话（72 小时 398 次运行、看图工具只调了 86 次），
+   * 于是被问图上有什么时显得很瞎。这里改成自动附图，不依赖她主动调 get_message_images。
+   * 上限 3 张、单张走 tools-core 同一套下载/压缩逻辑；任何一张失败都不影响整轮。
+   */
+  async #collectTriggerImages(triggerEntries, signal) {
+    const out = [];
+    for (const entry of (triggerEntries || []).slice(-8)) {
+      let media = entry?.media;
+      if (typeof media === 'string') { try { media = JSON.parse(media); } catch { media = null; } }
+      if (!Array.isArray(media)) continue;
+      for (const item of media.filter((x) => x && x.kind === 'image' && x.url)) {
+        if (out.length >= 3) return out;
+        try {
+          out.push(await downloadImageAsDataUrl(item.url, signal));
+        } catch (error) {
+          log.warn('[vision] 触发图下载失败：' + String(error?.message ?? error).slice(0, 120));
+        }
+      }
+    }
+    return out;
+  }
