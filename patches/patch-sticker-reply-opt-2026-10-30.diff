+/**
+ * 只有表情包、没有任何文字或明确指向时，随机触发不应主动插话。
+ * 消息仍留在已读历史里，后续被点名或进入活跃线程时仍可读取。
+ */
+export function isStickerOnlyBatch(triggerEntries = [], selfId = '') {
+  const humans = (Array.isArray(triggerEntries) ? triggerEntries : []).filter((message) => !message?.self);
+  if (!humans.length) return false;
+  let stickerCount = 0;
+  for (const message of humans) {
+    if (message?.mentionsSelf === true) return false;
+    if (selfId && message?.reply?.senderId && String(message.reply.senderId) === String(selfId)) return false;
+    let media = message?.media;
+    if (typeof media === 'string') {
+      try { media = JSON.parse(media); } catch { media = []; }
+    }
+    const list = Array.isArray(media) ? media : [];
+    const stickers = list.filter((item) => item?.kind === 'sticker'
+      || /动画表情|表情包/i.test(String(item?.summary || '')));
+    stickerCount += stickers.length;
+    const residual = String(message?.text || '')
+      .replace(/\[表情包\]/g, '')
+      .replace(/\[图片\]/g, '')
+      .replace(/\s+/g, '');
+    if (residual) return false;
+    if (!stickers.length) return false;
+  }
+  return stickerCount > 0;
+}
