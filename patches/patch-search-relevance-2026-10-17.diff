+/** 查询切词：去掉时间/疑问填充词，留下 ≥2 字的实词。 */
+function queryTokens(query) {
+  const STOP = new Set(['最新','新闻','今天','现在','最近','怎么样','什么','如何','多少','是谁','是什么','梗']);
+  return String(query || '')
+    .split(/[\s,，。；;、\/]+/)
+    .map((t) => t.replace(/^(什么是|是什么|是谁|有哪些|怎么|为什么)/, '').trim())
+    .filter((t) => t.length >= 2 && !STOP.has(t));
+}
+
+/** 命中分 = 命中词的总字数（"上海 台风"里只有"上海"的旅游页 2 分，两个都中的 4 分）。 */
+function relevanceScore(item, tokens) {
+  if (!tokens.length) return 1;
+  const hay = [item?.title || '', item?.snippet || '', item?.url || ''].join(' ').toLowerCase();
+  let score = 0;
+  for (const t of tokens) if (hay.includes(t.toLowerCase())) score += t.length;
+  return score;
+}
