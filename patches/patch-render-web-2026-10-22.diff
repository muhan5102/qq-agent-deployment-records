+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { crawl4aiAvailable, renderWebPage } from '../src/tools/render-web.js';
+import { buildToolDefs } from '../src/tools/tools-core.js';
+
+test('render_web_page 工具已注册，并说明动态页面和评论区用途', () => {
+  const tool = buildToolDefs().find((item) => item.name === 'render_web_page');
+  assert.ok(tool);
+  assert.deepEqual(tool.parameters.required, ['url']);
+  assert.match(tool.description, /JavaScript/);
+  assert.match(tool.description, /评论/);
+});
+
+test('renderWebPage 在启动浏览器前拒绝本机/内网地址', async () => {
+  await assert.rejects(() => renderWebPage('http://127.0.0.1:3210/'), /内网|本机/);
+});
+
+test('Crawl4AI 能渲染普通公开网页', { skip: !crawl4aiAvailable() }, async () => {
+  const result = await renderWebPage('https://example.com');
+  assert.match(result.title, /Example Domain/);
+  assert.match(result.markdown, /documentation examples|文档示例/);
+});
