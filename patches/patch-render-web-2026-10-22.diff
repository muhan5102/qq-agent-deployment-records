@@ -0,0 +1,85 @@
+// 按需启用的动态网页渲染：只有普通 web_fetch 拿不到正文时才启动 Chromium。
+import { spawn } from 'node:child_process';
+import fs from 'node:fs';
+import { validateFetchUrl } from '../llm/safe-fetch.js';
+
+const CRAWL_PYTHON = process.env.QQ_AGENT_CRAWL4AI_PYTHON
+  || '/mnt/data/qq-agent/tools/crawl4ai/venv/bin/python';
+const CRAWL_SCRIPT = process.env.QQ_AGENT_CRAWL4AI_SCRIPT
+  || '/mnt/data/qq-agent/tools/crawl4ai/fetch_page.py';
+const MAX_OUTPUT_BYTES = 2 * 1024 * 1024;
+const TIMEOUT_MS = 55_000;
+
+let active = 0;
+
+export function crawl4aiAvailable() {
+  return fs.existsSync(CRAWL_PYTHON) && fs.existsSync(CRAWL_SCRIPT);
+}
+
+export async function renderWebPage(rawUrl, { signal } = {}) {
+  if (!crawl4aiAvailable()) throw new Error('Crawl4AI 未安装或不完整');
+  const validated = await validateFetchUrl(rawUrl);
+  if (active >= 1) throw new Error('另一个网页正在渲染，请稍后再试');
+  active += 1;
+  try {
+    const result = await new Promise((resolve, reject) => {
+      const child = spawn(CRAWL_PYTHON, [CRAWL_SCRIPT, validated.url.toString()], {
+        stdio: ['ignore', 'pipe', 'pipe'],
+        windowsHide: true,
+        env: { ...process.env, CRAWL4AI_NO_CLOUD_NOTICE: '1' }
+      });
+      const stdout = [];
+      let outputBytes = 0;
+      let stderr = '';
+      let settled = false;
+      const finish = (error, value) => {
+        if (settled) return;
+        settled = true;
+        clearTimeout(timer);
+        signal?.removeEventListener('abort', onAbort);
+        if (error) reject(error);
+        else resolve(value);
+      };
+      const fail = (error) => {
+        try { child.kill('SIGKILL'); } catch { /* noop */ }
+        finish(error);
+      };
+      const onAbort = () => fail(signal?.reason || new Error('已中止'));
+      const timer = setTimeout(() => fail(new Error('动态网页渲染超时')), TIMEOUT_MS);
+      signal?.addEventListener('abort', onAbort, { once: true });
+      child.stdout.on('data', (chunk) => {
+        outputBytes += chunk.length;
+        if (outputBytes > MAX_OUTPUT_BYTES) return fail(new Error('网页渲染输出过大'));
+        stdout.push(chunk);
+      });
+      child.stderr.on('data', (chunk) => {
+        stderr = (stderr + chunk.toString('utf8')).slice(-3000);
+      });
+      child.on('error', (error) => finish(new Error(`Crawl4AI 无法启动：${error.message}`)));
+      child.on('close', (code) => {
+        if (settled) return;
+        if (code !== 0) {
+          const detail = stderr.trim().split('\n').slice(-2).join('；').slice(-500);
+          return finish(new Error(`网页渲染失败（${code}）：${detail || '无错误输出'}`));
+        }
+        try {
+          finish(null, JSON.parse(Buffer.concat(stdout).toString('utf8')));
+        } catch {
+          finish(new Error('Crawl4AI 返回了无法解析的数据'));
+        }
+      });
+    });
+    if (!result?.success) throw new Error(result?.error || '网页渲染失败');
+    if (result.finalUrl) await validateFetchUrl(result.finalUrl);
+    const markdown = String(result.markdown || '').trim();
+    if (!markdown) throw new Error('网页渲染成功，但没有提取到正文');
+    return {
+      title: String(result.title || '').trim(),
+      finalUrl: String(result.finalUrl || rawUrl),
+      markdown,
+      truncated: result.truncated === true
+    };
+  } finally {
+    active = Math.max(0, active - 1);
+  }
+}
