+const DEEP_VIDEO_INTENT = /(?:详细分析|完整分析|认真看完整|认真看完|完整看一遍|做详细笔记|做成详细笔记|完整笔记)/;
+const DEEP_VIDEO_NEGATION = /(?:不要|不用|无需|不必|别)(?:再)?(?:详细分析|完整分析|认真看|做详细笔记|做成详细笔记)/;
+
+/** 只检查本轮触发消息，决定是否强制视频工具进入 deep 模式。 */
+export function hasDeepVideoIntent(triggerEntries) {
+  return (Array.isArray(triggerEntries) ? triggerEntries : []).some((message) => {
+    if (message?.self) return false;
+    const text = String(message?.text || '').trim();
+    return text && DEEP_VIDEO_INTENT.test(text) && !DEEP_VIDEO_NEGATION.test(text);
+  });
+}
+
+export function applyDeepVideoIntent(args, triggerEntries) {
+  if (!args || typeof args !== 'object' || Array.isArray(args) || !hasDeepVideoIntent(triggerEntries)) return args;
+  return { ...args, mode: 'deep' };
+}
